    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nbody {\n  font-family: Arial, sans-serif;\n  padding: 30px;\n}\n\nh1 {\n  color: #1F2937;\n}\n\ntable {\n  width: 100%;\n  border-collapse: collapse;\n  margin-top: 15px;\n}\n\nth {\n  background: #f3f4f6;\n  padding: 10px;\n  text-align: left;\n}\n\ntd {\n  padding: 10px;\n  border-bottom: 1px solid #ddd;\n}\n\n.section {\n  margin-top: 25px;\n}\n</style>\n</head>\n<body>\n\n<h1>Weekly Business Performance Report</h1>\n\n<div class=\"section\">\n<h2>Executive Summary</h2>\n<p>\n{{ $json.output.executive_summary }}\n</p>\n</div>\n\n<div class=\"section\">\n<h2>Key Metrics</h2>\n\n<table>\n<tr>\n<th>Metric</th>\n<th>Value</th>\n</tr>\n\n<tr><td>Total Revenue</td><td>$45,000</td></tr>\n<tr><td>Gross Profit</td><td>$18,000</td></tr>\n<tr><td>New Leads</td><td>32</td></tr>\n<tr><td>Conversion Rate</td><td>28%</td></tr>\n<tr><td>Jobs Completed</td><td>41</td></tr>\n<tr><td>Outstanding Invoices</td><td>$8,500</td></tr>\n<tr><td>Customer Satisfaction</td><td>4.8/5</td></tr>\n<tr><td>Business Health Score</td><td>87/100</td></tr>\n\n</table>\n</div>\n\n<div class=\"section\">\n<h2>Key Highlights</h2>\n<ul>\n<li>{{ $json.output.highlights[0] }}</li>\n<li>{{ $json.output.highlights[1] }}</li>\n<li>{{ $json.output.highlights[2] }}</li>\n</ul>\n</div>\n\n<div class=\"section\">\n<h2>Recommended Actions</h2>\n\n<table>\n<tr>\n<th>Priority</th>\n<th>Action</th>\n</tr>\n\n<tr>\n<td>High</td>\n<td>{{ $json.output.actions[0] }}</td>\n</tr>\n\n<tr>\n<td>Medium</td>\n<td>{{ $json.output.actions[1] }}</td>\n</tr>\n\n<tr>\n<td>Low</td>\n<td>{{ $json.output.actions[2] }}</td>\n</tr>\n\n</table>\n</div>\n\n</body>\n</html>"
      },
